# Copy this file to deploy/im.env and replace each credential needed by your enabled bindings.
# Account and tenant authority come from the persisted ChannelBinding.
# Set the variable named by its secret_ref, for example env:TRPC_WECOM_BOT_SECRET.
TRPC_WECOM_BOT_SECRET=replace-with-your-bot-secret
# Standard HTTP callback only: Token and EncodingAESKey configured in the
# Enterprise WeChat application. They are distinct from the AI Bot secret.
TRPC_WECOM_WEBHOOK_TOKEN=replace-with-your-webhook-token
TRPC_WECOM_WEBHOOK_AES_KEY=replace-with-your-encoding-aes-key
TRPC_FEISHU_APP_SECRET=replace-with-your-app-secret
