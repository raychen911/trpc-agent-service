# Merge into the deployment's operator environment or Compose .env file.
# Use a dedicated MinIO/S3 bucket and credentials. These are references/examples,
# not working secrets; no production archival is enabled by this file alone.
TRPC_AUDIT_ARCHIVE_ENDPOINT=minio:9000
TRPC_AUDIT_ARCHIVE_SECURE=false
TRPC_AUDIT_ARCHIVE_BUCKET=trpc-audit-archives
TRPC_AUDIT_ARCHIVE_ACCESS_KEY=
TRPC_AUDIT_ARCHIVE_SECRET_KEY=
# Comma-separated Fernet keys: current key first, older decryption keys after it.
# Keep archive keys independently of IM routing keys and include them in recovery.
TRPC_AUDIT_ARCHIVE_KEYS=
TRPC_AUDIT_ARCHIVE_INTERVAL=300
TRPC_AUDIT_ARCHIVE_BATCH_SIZE=200

# Publish audit_policy.archive_enabled=true for each intended tenant.
# audit_policy.retention_days controls SQL hot retention, not archive deletion.
# Archives and their SQL index receipts are retained; no object lifecycle deletion
# or regulatory WORM guarantee is implied by versioning and authenticated encryption.
# Start the periodic worker after normal service/database initialization:
# docker compose -f docker-compose.live.yml --profile audit up -d --wait audit-retention
# One bounded, operator-triggered pass (policy must already be enabled):
# python -m trpc_service._cli audit-archive --tenant-id TENANT
# Verify up to 500 archives; follow next_sequence with --after-sequence:
# python -m trpc_service._cli audit-verify --tenant-id TENANT
