        "profile_id": "vector_prod",
        "namespace": "demo_wecom"
      },
      "artifact": {
        "kind": "object",
        "profile_id": "object_prod",
        "namespace": "demo_wecom"
      },
      "audit": {
        "kind": "sql",
        "profile_id": "sql_audit",
        "namespace": "demo_wecom"
      }
    },
    "audit_policy": {
      "retention_days": 180,
      "record_prompt_body": false,
      "record_response_body": false,
      "hash_external_identifiers": true,
      "redact_pii": true,
      "redact_secrets": true,
      "allowed_viewer_roles": [
        "tenant_auditor"
      ]
    }
  },
