TRPC_SERVICE_ENVIRONMENT=kubernetes
TRPC_SERVICE_HOST=0.0.0.0
TRPC_SERVICE_PORT=8000
TRPC_SERVICE_LOG_LEVEL=INFO
TRPC_SERVICE_DATABASE_URL=postgresql+asyncpg://trpc@postgres:5432/trpc_agent
TRPC_SERVICE_DATABASE_PASSWORD_FILE=/run/secrets/platform/postgres_password
TRPC_SERVICE_SESSION_CACHE_URL=redis://redis:6379/0
TRPC_SERVICE_SESSION_CACHE_TTL_SECONDS=1800
TRPC_SERVICE_SESSION_CACHE_MAX_EVENTS=40
TRPC_SERVICE_ADMIN_BOOTSTRAP_TOKEN_FILE=/run/secrets/platform/admin_bootstrap_token
TRPC_SERVICE_TENANT_SECRET_MASTER_KEY_FILE=/run/secrets/platform/tenant_secret_master_key
TRPC_SERVICE_SECURE_COOKIES=false
TRPC_SERVICE_TELEMETRY_ENABLED=true
TRPC_SERVICE_OTLP_HTTP_ENDPOINT=http://otel-collector:4318
TRPC_SERVICE_NODE_HEARTBEAT_INTERVAL_SECONDS=5
TRPC_SERVICE_NODE_STALE_AFTER_SECONDS=20
TRPC_SERVICE_WORKER_CONCURRENCY_PER_NODE=1
TRPC_SERVICE_WORKER_SCALER_MODE=kubernetes
TRPC_SERVICE_WORKER_POOL_RECONCILE_INTERVAL_SECONDS=1
TRPC_SERVICE_KUBERNETES_WORKER_DEPLOYMENT=agent-worker
TRPC_SERVICE_WORKER_LEASE_SECONDS=180
TRPC_SERVICE_WORKER_POLL_INTERVAL_SECONDS=0.25
TRPC_SERVICE_WORKER_RETRY_BASE_SECONDS=5
TRPC_SERVICE_WORKER_RETRY_MAX_SECONDS=300
TRPC_SERVICE_RETRY_JITTER_RATIO=0.2
TRPC_SERVICE_WORKER_MAX_ATTEMPTS=5
TRPC_SERVICE_DELIVERY_CONCURRENCY=1
TRPC_SERVICE_DELIVERY_LEASE_SECONDS=60
TRPC_SERVICE_DELIVERY_POLL_INTERVAL_SECONDS=0.5
TRPC_SERVICE_DELIVERY_RETRY_BASE_SECONDS=5
TRPC_SERVICE_DELIVERY_RETRY_MAX_SECONDS=900
TRPC_SERVICE_DELIVERY_MAX_ATTEMPTS=8
TRPC_SERVICE_CHANNEL_RECONCILE_INTERVAL_SECONDS=5
TRPC_SERVICE_MODEL_TIMEOUT_SECONDS=120
TRPC_SERVICE_APPROVAL_TTL_SECONDS=600
TRPC_SERVICE_WORKSPACE_ROOT=/data/workspaces
TRPC_SERVICE_WORKSPACE_RETENTION_SECONDS=604800
TRPC_SERVICE_WORKSPACE_CLEANUP_INTERVAL_SECONDS=300
TRPC_SERVICE_LLM={"provider":"bailian_openai","model_name":"qwen-max","vision_model_name":"qwen-vl-max","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","api_key_ref":"env://DASHSCOPE_API_KEY","temperature":0.2,"max_output_tokens":4096}
TRPC_SERVICE_AGENT_INSTRUCTION=你是一个可靠、简洁的企业级智能助手。
TRPC_SERVICE_EMBEDDING={"provider_name":"bailian","model_name":"text-embedding-v4","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","api_key_ref":"env://DASHSCOPE_API_KEY","dimensions":1024,"batch_size":10}
TRPC_SERVICE_STORAGE_BACKENDS={"inmemory":{"kind":"inmemory"},"facts":{"kind":"postgresql","url":"postgresql+asyncpg://trpc@postgres:5432/trpc_agent","password_ref":"file:///run/secrets/platform/postgres_password"},"vectors":{"kind":"pgvector","url":"postgresql+asyncpg://trpc@postgres:5432/trpc_agent","password_ref":"file:///run/secrets/platform/postgres_password","embedding_provider":"bailian"},"objects":{"kind":"s3","endpoint_url":"http://seaweedfs:8333","bucket":"trpc-artifacts","anonymous":true}}
TRPC_SERVICE_STORAGE_PROFILE={"session":"facts","memory":"facts","summary":"facts","knowledge":"vectors","artifact":"objects","audit":"facts"}
