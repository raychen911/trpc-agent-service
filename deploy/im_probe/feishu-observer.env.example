# Copy to /etc/trpc-im-probe/feishu-observer.env as root:trpcagent 0640.
# This service intentionally receives no App Secret or WeCom configuration.
# Referenced secret files must also be non-symlink root:trpcagent 0640 files.
TRPC_FEISHU_OBSERVER_APP_ID=cli_<real-feishu-app-id>
TRPC_FEISHU_OBSERVER_VERIFICATION_TOKEN_FILE=/etc/trpc-im-probe/secrets/feishu_verification_token
TRPC_FEISHU_OBSERVER_ENCRYPT_KEY_FILE=/etc/trpc-im-probe/secrets/feishu_encrypt_key
