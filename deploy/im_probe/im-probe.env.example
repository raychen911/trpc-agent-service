# Copy to /etc/trpc-im-probe/im-probe.env on the probe host.
# Do not commit the host-specific file. Values below are placeholders and the
# server rejects placeholders, mutable paths, and tag-only image identities.
TRPC_IM_PROBE_APPLICATION_ROOT=/opt/trpc-im-probe/current
TRPC_IM_PROBE_BIND_HOST=127.0.0.1
TRPC_IM_PROBE_PORT=8750
TRPC_IM_PROBE_SIGNING_KEY_FILE=/etc/trpc-im-probe/secrets/im_probe_ed25519_private_key
TRPC_IM_PROBE_KEY_ID=im-probe-key-2026
# Root-owned immutable JSON containing exactly schema_version, release_id,
# nonce_sha256, source_fingerprint, and image_digest. The probe measures the
# deployed checkout fingerprint and refuses a context copied from other code.
TRPC_IM_PROBE_RELEASE_CONTEXT_FILE=/etc/trpc-im-probe/release-context.json
TRPC_IM_PROBE_IDENTITY_SHA256=<64-hex-fixed-probe-identity>

# These are provider account identifiers, not secret values. They must match
# the Feishu binding account_id and WeCom bot ID used for this probe.
TRPC_IM_PROBE_FEISHU_APP_ID=cli_<real-feishu-app-id>
TRPC_IM_PROBE_WECOM_BOT_ID=<real-wecom-bot-id>

# Host-owned, non-symlink regular files (root:trpcagent 0640). Copy them
# atomically from the approved Secret source; do not symlink another directory.
# The probe reads them only to compare request credential fingerprints and
# gives only paths to the runner.
TRPC_IM_PROBE_FEISHU_APP_SECRET_FILE=/etc/trpc-im-probe/secrets/feishu_app_secret
TRPC_IM_PROBE_FEISHU_VERIFICATION_TOKEN_FILE=/etc/trpc-im-probe/secrets/feishu_verification_token
TRPC_IM_PROBE_FEISHU_ENCRYPT_KEY_FILE=/etc/trpc-im-probe/secrets/feishu_encrypt_key
TRPC_IM_PROBE_WECOM_BOT_SECRET_FILE=/etc/trpc-im-probe/secrets/wecom_bot_secret

# Channel-specific, operator-owned control profiles bind each gate request to
# the exact permitted control actions. Keep them private, immutable regular
# files. The local socket exposes those actions without giving the driver
# Kubernetes, database, OIDC, or provider-admin credentials.
TRPC_IM_PROBE_FEISHU_CONTROL_PROFILE_FILE=/etc/trpc-im-probe/feishu-control-profile.json
TRPC_IM_PROBE_WECOM_CONTROL_PROFILE_FILE=/etc/trpc-im-probe/wecom-control-profile.json
TRPC_IM_PROBE_CONTROL_SOCKET=/run/trpc-im-probe/control.sock
# Must be the numeric uid of system user trpcimbroker, which must differ from
# the trpcagent uid. The gid is the shared trpcagent group used by both units.
TRPC_IM_PROBE_BROKER_UID=<numeric-trpcimbroker-uid>
TRPC_IM_PROBE_BROKER_GID=<numeric-trpcagent-group-gid>
TRPC_IM_CONTROL_BROKER_CONFIG_FILE=/etc/trpc-im-probe/control-broker.json

# Optional old/new credential files used by the provider runner's credential
# rotation case. The probe never copies their contents into evidence.
# TRPC_IM_PROBE_FEISHU_OLD_APP_SECRET_FILE=/secure/old-feishu-app-secret
# TRPC_IM_PROBE_FEISHU_NEW_APP_SECRET_FILE=/secure/new-feishu-app-secret
# TRPC_IM_PROBE_WECOM_OLD_BOT_SECRET_FILE=/secure/old-wecom-bot-secret
# TRPC_IM_PROBE_WECOM_NEW_BOT_SECRET_FILE=/secure/new-wecom-bot-secret

# This is an executable, independently reviewed provider test runner. It must
# emit one strict JSON object on stdout containing provider_evidence. Leaving
# it empty keeps the endpoint signed but not_run; it can never produce a pass.
# Keep the runner outside the application checkout so it is independently
# reviewed and cannot silently share the under-test service implementation.
TRPC_IM_PROBE_RUNNER=/usr/local/libexec/trpc-im-provider-runner
TRPC_IM_PROBE_RUNNER_SHA256=<sha256-of-installed-provider-runner>
TRPC_IM_PROBE_FEISHU_DRIVER=/usr/local/libexec/trpc-im-feishu-evidence-driver
TRPC_IM_PROBE_FEISHU_DRIVER_SHA256=<sha256-of-installed-feishu-driver>
TRPC_IM_PROBE_WECOM_DRIVER=/usr/local/libexec/trpc-im-wecom-evidence-driver
TRPC_IM_PROBE_WECOM_DRIVER_SHA256=<sha256-of-installed-wecom-driver>
TRPC_IM_PROBE_RUNNER_TIMEOUT_SECONDS=180
TRPC_IM_PROBE_DRIVER_TIMEOUT_SECONDS=180

# Release-gate side values are kept in the same operator-owned configuration
# file so a candidate switch is made once. Provider credential *values* are
# still injected separately by the secret manager when im_online_gate runs.
TRPC_IM_ONLINE_TESTS_ENABLED=true
TRPC_IM_ONLINE_PROBE_URL=https://probe.example.invalid
TRPC_IM_ONLINE_PROBE_URL_ALLOWLIST=https://probe.example.invalid
TRPC_IM_ONLINE_PROBE_IDENTITY_SHA256=<64-hex-fixed-probe-identity>
TRPC_IM_ONLINE_IMAGE_DIGEST=sha256:<candidate-image-digest>
TRPC_IM_ONLINE_FEISHU_CONTROL_PROFILE_SHA256=<sha256-of-rendered-feishu-control-profile>
TRPC_IM_ONLINE_WECOM_CONTROL_PROFILE_SHA256=<sha256-of-rendered-wecom-control-profile>
TRPC_RELEASE_ID=<current-release-id>
TRPC_RELEASE_NONCE=<current-high-entropy-release-nonce>
