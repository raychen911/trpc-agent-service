        "wecom_media": {"executable": "/usr/local/libexec/trpc-im-wecom-control-action", "sha256": "<sha256-of-wecom-control-action>", "argv": ["--config", "/etc/trpc-im-probe/wecom-control-action.json"], "timeout_seconds": 180},
        "wecom_reconnect": {"executable": "/usr/local/libexec/trpc-im-wecom-control-action", "sha256": "<sha256-of-wecom-control-action>", "argv": ["--config", "/etc/trpc-im-probe/wecom-control-action.json"], "timeout_seconds": 180},
