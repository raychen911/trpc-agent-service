[flake8]
max-line-length = 120
extend-ignore = E203
exclude =
    .git,
    .venv,
    build,
    dist,
    .pytest_cache
per-file-ignores =
    tests/test_platform.py:E402
    tests/test_reliability.py:E402
    scripts/*.py:E402
    tests/test_storage_state_edges.py:E501,E731
    tests/test_tenant_repository_coverage.py:E501,E306,F401
    tests/test_tenant_service_deep_coverage.py:E501
    tests/test_web_app_coverage.py:E501,E306,F841
    tests/*.py:E,F,W
    tests/test_storage_state_edges.py:F
    tests/test_tenant_service_deep_coverage.py:F
