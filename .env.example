# Copy this file to .env. Never commit the real .env file.
# Supported providers: openai-compatible, anthropic, litellm
TRPC_AGENT_MODEL_PROVIDER=openai-compatible
TRPC_AGENT_MODEL_NAME=gpt-4o-mini
TRPC_AGENT_BASE_URL=https://api.openai.com/v1
TRPC_AGENT_API_KEY=replace-with-your-api-key

# Optional service settings
TRPC_SERVICE_ENV=development
TRPC_SERVICE_CONFIG=examples/config/tenants.yaml
TRPC_SERVICE_HOST=127.0.0.1
TRPC_SERVICE_PORT=8080
TRPC_SERVICE_ROLES=gateway,worker,delivery,admin
TRPC_SERVICE_REDIS_URL=redis://127.0.0.1:6379/15
TRPC_SERVICE_POSTGRES_URL=postgresql://trpc_agent:change-me@127.0.0.1:5432/trpc_agent_service
TRPC_SERVICE_ADMIN_TOKEN=replace-with-admin-token
TRPC_TENANT_DEMO_TOKEN=replace-with-tenant-token
TRPC_SERVICE_OTLP_ENDPOINT=

# Optional real IM verification. The unified command reads these values from .env.
WECOM_BOT_ID=
WECOM_BOT_SECRET=

# Optional official WeChat Customer Service. Offline demos never use these.
# Use examples/config/wecom-kf.yaml explicitly; do not enable without credentials.
WECOM_KF_CORP_ID=
WECOM_KF_OPEN_KFID=
WECOM_KF_SECRET=
WECOM_KF_CALLBACK_TOKEN=
WECOM_KF_ENCODING_AES_KEY=
WECOM_KF_TEST_EXTERNAL_USER_ID=

TELEGRAM_BOT_TOKEN=
TELEGRAM_TEST_CHAT_ID=
