TAP_ENVIRONMENT=development
TAP_SERVICE_ROLE=all
TAP_NODE_ID=local-1
TAP_HOST=0.0.0.0
TAP_PORT=8080
# Keep Compose loopback-only unless a path-filtering TLS reverse proxy is configured.
TAP_PUBLIC_BIND_ADDRESS=127.0.0.1
TAP_CONTROL_DATABASE_URL=sqlite+aiosqlite:///./tenant-agent.db
TAP_BOOTSTRAP_CONFIG_PATH=config/tenants.example.yaml
TAP_AUTO_CREATE_SCHEMA=true
TAP_SESSION_HMAC_KEY=replace-with-at-least-32-random-characters
TAP_ADMIN_BEARER_TOKEN=replace-admin-token
TAP_INTERNAL_BEARER_TOKEN=replace-internal-token
TENANT_DEMO_WEBHOOK_TOKEN=development-webhook-token
TAP_BROKER_MODE=inline
# Production:
# POSTGRES_ADMIN_PASSWORD=replace-with-migration-role-password
# POSTGRES_APP_PASSWORD=replace-with-runtime-role-password
# TAP_REDIS_URL=redis://redis:6379/0
# TAP_BROKER_MODE=redis-streams
# TAP_REDIS_STREAM=tap:{inbound}:v1
# TAP_BROKER_GLOBAL_QUEUE_LIMIT=100000
# TAP_BROKER_TENANT_QUEUE_LIMIT=10000
# TAP_WORKER_MAX_ATTEMPTS=8
# TAP_CONFIG_PREFLIGHT_TIMEOUT_SECONDS=30
# TAP_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
# VAULT_ADDR=https://vault.example.com
# VAULT_TOKEN_FILE=/run/secrets/vault-token  # preferred renewable workload-auth sink
# VAULT_CHANNEL_TOKEN=inject-a-role-scoped-short-lived-token
# VAULT_WORKER_TOKEN=inject-a-role-scoped-short-lived-token
# VAULT_OUTBOX_TOKEN=inject-a-role-scoped-short-lived-token
# VAULT_ADMIN_TOKEN=inject-a-role-scoped-short-lived-token
# WeCom intelligent bot WebSocket (optional; distinct from CorpID/AgentID mode):
# TENANT_ACME_WECOM_BOT_ID=your-bot-id
# TENANT_ACME_WECOM_BOT_SECRET=your-bot-secret
