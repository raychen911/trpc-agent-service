# Canonical process settings. Copy to .env and never commit real values.
TRPC_SERVICE_ENVIRONMENT=development
TRPC_SERVICE_ROLE=all
TRPC_SERVICE_HOST=0.0.0.0
TRPC_SERVICE_PORT=8080
TRPC_SERVICE_TENANTS_CONFIG=deploy/tenants.yaml
TRPC_SERVICE_REDIS_URL=redis://127.0.0.1:6379/0
TRPC_SERVICE_MYSQL_URL=mysql+pymysql://agent:change-me@127.0.0.1:3306/trpc_agent
TRPC_SERVICE_TENANT_CONFIG_ENCRYPTION_KEY=change-me
TRPC_SERVICE_MODEL_API_KEY=replace-me
TRPC_SERVICE_ADMIN_API_KEY=replace-me
TRPC_SERVICE_QUEUE_ENABLED=true
TRPC_SERVICE_DURABLE_DELIVERY_ENABLED=true
TRPC_SERVICE_TEST_API_ENABLED=false
TRPC_SERVICE_TEST_API_KEY=
TRPC_SERVICE_SECRET_FILE_ROOT=/run/secrets
TRPC_SERVICE_OUTBOX_POLL_INTERVAL_SECONDS=1
TRPC_SERVICE_OUTBOX_MAX_ATTEMPTS=8
TRPC_SERVICE_DEEPSEEK_INPUT_PRICE_PER_MTOK=0.22
TRPC_SERVICE_DEEPSEEK_OUTPUT_PRICE_PER_MTOK=0.66

# Binding-specific SecretRefs may point at any safely named environment key.
TRPC_SERVICE_QQ_GREETING_APP_ID=
TRPC_SERVICE_QQ_GREETING_APP_SECRET=
TRPC_SERVICE_QQ_CHAT_APP_ID=
TRPC_SERVICE_QQ_CHAT_APP_SECRET=
