# Copy to .env locally and fill in a newly generated key.
# Never commit the real .env file.
OPENAI_API_KEY=
CPA_BASE_URL=
CPA_MODEL=
CPA_API_KEY_ENV=OPENAI_API_KEY
CPA_WIRE_API=responses
CPA_TIMEOUT_MS=60000
CPA_MAX_RETRIES=3
CPA_MAX_OUTPUT_TOKENS=1024
GATEWAY_PORT=8000
REDIS_PORT=6379
POSTGRES_PORT=5432
POSTGRES_PASSWORD=
# Set to 1 to reuse the locally installed original codex-cli provider.
CPA_USE_CODEX_CLI=0
CPA_CODEX_EXECUTABLE=
CPA_CODEX_CWD=
TRPC_AGENT_RUNTIME_MODE=trpc
# Docker Compose runs inside the project network, so service DSNs must use
# container service names. Use localhost only for host-side scripts.
REDIS_URL=redis://redis:6379/0
POSTGRES_DSN=postgresql://trpc_agent:<local-password>@sql:5432/trpc_agent
TENANT_DB_DSN=postgresql://trpc_agent:<local-password>@sql:5432/trpc_agent
# Optional PostgreSQL second-line tenant isolation. Keep disabled for the
# local demo. In production POSTGRES_DSN must use the app role and
# TENANT_DB_DSN must use the admin/control-plane role.
POSTGRES_RLS_ENABLED=0
POSTGRES_AUTO_CREATE_SCHEMA=1
POSTGRES_SCHEMA_DSN=
POSTGRES_RLS_APP_ROLE=trpc_agent_app
POSTGRES_RLS_ADMIN_ROLE=trpc_agent_admin
POSTGRES_RLS_APP_PASSWORD=
POSTGRES_RLS_ADMIN_PASSWORD=
WORKER_QUEUE_URL=redis://redis:6379/0
WORKER_RESULT_TIMEOUT_SECONDS=60
OUTBOUND_QUEUE_URL=redis://redis:6379/0
OUTBOUND_QUEUE_ENABLED=1
OUTBOUND_QUEUE_CONSUMER=0
REQUIRE_OUTBOUND_QUEUE=1
WORKER_QUEUE_TRANSPORT=list
WORKER_STREAM_GROUP=workers
WORKER_STREAM_CONSUMER=
DURABLE_INBOX_OUTBOX=0
INBOX_LEASE_SECONDS=180
SESSION_LEASE_TTL_SECONDS=120
SESSION_LOCK_TTL_SECONDS=120
REQUIRE_ETAG=0
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_AUDIENCE=
OIDC_ROLE_CLAIM=role
OIDC_TENANTS_CLAIM=tenants
OIDC_DEFAULT_ROLE=viewer
OIDC_JWKS_CACHE_SECONDS=300
DURABLE_OUTBOX_SINK_URL=
DURABLE_OUTBOX_STREAM=trpc-agent:outbox:events
DURABLE_OUTBOX_MAX_ATTEMPTS=10
ADMIN_API_KEY=
VALIDATE_SECRETS=0
COMPENSATION_WORKER=1
COMPENSATION_REPLAY_LIMIT=100
COMPENSATION_INTERVAL_SECONDS=5
COMPENSATION_VISIBILITY_TIMEOUT_SECONDS=180
COMPENSATION_MAX_ATTEMPTS=10
OBJECT_ENDPOINT=
OBJECT_BUCKET=
OBJECT_REGION=us-east-1
OBJECT_ACCESS_KEY_REF=
OBJECT_SECRET_KEY_REF=
VECTOR_URL=
VECTOR_TOKEN_REF=
EXTERNAL_MEMORY_URL=
EXTERNAL_MEMORY_TOKEN_REF=
OTEL_EXPORTER_OTLP_ENDPOINT=
