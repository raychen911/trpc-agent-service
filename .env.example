# Local development template. Copy it to .env; .env is ignored by Git.
# Infrastructure secrets are generated under .secrets/ by start.sh.
TRPC_SERVICE_PORT=8000
# JSON/form request cap; authenticated knowledge uploads retain their 10 MiB cap.
TRPC_SERVICE_HTTP_MAX_BODY_BYTES=1048576
TRPC_SERVICE_LOG_LEVEL=INFO
TRPC_SERVICE_LOG_MAX_BYTES=20971520
TRPC_SERVICE_LOG_BACKUP_COUNT=7
# start.sh launches one HTTP Gateway plus this many independent host-Python Workers.
TRPC_SERVICE_LOCAL_WORKER_NODES=2
TRPC_SERVICE_WORKER_CONCURRENCY_PER_NODE=1
TRPC_SERVICE_WORKER_SCALER_MODE=local_process
TRPC_SERVICE_WORKER_POOL_RECONCILE_INTERVAL_SECONDS=1
TRPC_SERVICE_WORKER_RUN_DIR=.run/workers
TRPC_SERVICE_WORKER_LOG_DIR=.run
TRPC_SERVICE_KUBERNETES_API_URL=https://kubernetes.default.svc
TRPC_SERVICE_KUBERNETES_NAMESPACE_FILE=/var/run/secrets/kubernetes.io/serviceaccount/namespace
TRPC_SERVICE_KUBERNETES_TOKEN_FILE=/var/run/secrets/kubernetes.io/serviceaccount/token
TRPC_SERVICE_KUBERNETES_CA_FILE=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt
TRPC_SERVICE_KUBERNETES_WORKER_DEPLOYMENT=agent-worker
TRPC_SERVICE_WORKER_LEASE_SECONDS=180
TRPC_SERVICE_WORKER_POLL_INTERVAL_SECONDS=0.25
TRPC_SERVICE_WORKER_RETRY_BASE_SECONDS=5
TRPC_SERVICE_WORKER_RETRY_MAX_SECONDS=300
TRPC_SERVICE_RETRY_JITTER_RATIO=0.2
TRPC_SERVICE_WORKER_MAX_ATTEMPTS=5
TRPC_SERVICE_DELIVERY_CONCURRENCY=1
TRPC_SERVICE_DELIVERY_LEASE_SECONDS=60
TRPC_SERVICE_DELIVERY_POLL_INTERVAL_SECONDS=0.5
TRPC_SERVICE_DELIVERY_RETRY_BASE_SECONDS=5
TRPC_SERVICE_DELIVERY_RETRY_MAX_SECONDS=900
TRPC_SERVICE_DELIVERY_MAX_ATTEMPTS=8
# The dedicated Channel Runtime owns both WeCom and Feishu long connections.
TRPC_SERVICE_CHANNEL_RECONCILE_INTERVAL_SECONDS=5
TRPC_SERVICE_NODE_HEARTBEAT_INTERVAL_SECONDS=5
TRPC_SERVICE_NODE_STALE_AFTER_SECONDS=20
TRPC_POSTGRES_PORT=55432
TRPC_REDIS_PORT=6379
# Recent conversation turns are cached in Redis; PostgreSQL remains authoritative.
TRPC_SERVICE_SESSION_CACHE_URL=redis://127.0.0.1:6379/0
TRPC_SERVICE_SESSION_CACHE_TTL_SECONDS=1800
TRPC_SERVICE_SESSION_CACHE_MAX_EVENTS=40
TRPC_SEAWEEDFS_S3_PORT=8333
TRPC_OTEL_GRPC_PORT=4317
TRPC_OTEL_HTTP_PORT=4318
TRPC_PROMETHEUS_PORT=9090
TRPC_GRAFANA_PORT=3000
TRPC_TEMPO_PORT=3200
TRPC_LOKI_PORT=3100
TRPC_ALLOY_PORT=12345
TRPC_SERVICE_TELEMETRY_ENABLED=true
TRPC_SERVICE_OTLP_HTTP_ENDPOINT=http://127.0.0.1:4318

POSTGRES_IMAGE=pgvector/pgvector:pg18
REDIS_IMAGE=redis:8.2-alpine
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.44
OTEL_IMAGE=otel/opentelemetry-collector-contrib:0.159.0
PROMETHEUS_IMAGE=prom/prometheus:v3.13.0
GRAFANA_IMAGE=grafana/grafana:13.2.0
TEMPO_IMAGE=grafana/tempo:3.0.2
LOKI_IMAGE=grafana/loki:3.6.15
ALLOY_IMAGE=grafana/alloy:v1.18.0

# Alibaba Cloud Model Studio (Bailian), OpenAI-compatible Beijing endpoint.
# Leave this empty in the template. Fill it only in the ignored local `.env`.
# Example format: DASHSCOPE_API_KEY=<YOUR_DASHSCOPE_API_KEY>
DASHSCOPE_API_KEY=
TRPC_SERVICE_LLM={"provider":"bailian_openai","model_name":"qwen-max","vision_model_name":"qwen-vl-max","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","api_key_ref":"env://DASHSCOPE_API_KEY","temperature":0.2,"max_output_tokens":4096}
TRPC_SERVICE_AGENT_INSTRUCTION=你是一个可靠、简洁的企业级智能助手。
TRPC_SERVICE_MODEL_TIMEOUT_SECONDS=120
TRPC_SERVICE_APPROVAL_TTL_SECONDS=600
# Empty means remote MCP endpoints must resolve to public addresses. For a
# reviewed internal MCP service, list exact private DNS names separated by commas.
TRPC_SERVICE_MCP_PRIVATE_ALLOWED_HOSTS=
# start.sh generates this local bootstrap credential with mode 0600.
TRPC_SERVICE_ADMIN_BOOTSTRAP_TOKEN_FILE=.secrets/admin_bootstrap_token
TRPC_SERVICE_TENANT_SECRET_MASTER_KEY_FILE=.secrets/tenant_secret_master_key
TRPC_SERVICE_MANAGEMENT_SESSION_TTL_SECONDS=28800
TRPC_SERVICE_MANAGEMENT_LOGIN_MAX_ATTEMPTS=5
TRPC_SERVICE_MANAGEMENT_LOGIN_LOCK_SECONDS=900
# Local HTTP uses false; set true whenever the public console is served over HTTPS.
TRPC_SERVICE_SECURE_COOKIES=false
TRPC_SERVICE_WORKSPACE_ROOT=data/workspaces
TRPC_SERVICE_WORKSPACE_RETENTION_SECONDS=604800
TRPC_SERVICE_WORKSPACE_CLEANUP_INTERVAL_SECONDS=300

# Tenant administrators configure Bot/App IDs and write-only credentials in the
# web console. Channel secrets are encrypted in SQL by the platform-owned key;
# neither plaintext credentials nor database references are returned by the API.

# Python runs on the host. These JSON values route capabilities independently;
# PostgreSQL already includes pgvector; the vector backend can reuse the facts URL
# after a concrete EmbeddingProvider is selected.
TRPC_SERVICE_EMBEDDING={"provider_name":"bailian","model_name":"text-embedding-v4","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","api_key_ref":"env://DASHSCOPE_API_KEY","dimensions":1024,"batch_size":10}
TRPC_SERVICE_STORAGE_BACKENDS={"inmemory":{"kind":"inmemory"},"facts":{"kind":"postgresql","url":"postgresql+asyncpg://trpc@127.0.0.1:55432/trpc_agent","password_ref":"file://.secrets/postgres_password"},"vectors":{"kind":"pgvector","url":"postgresql+asyncpg://trpc@127.0.0.1:55432/trpc_agent","password_ref":"file://.secrets/postgres_password","embedding_provider":"bailian"},"objects":{"kind":"s3","endpoint_url":"http://127.0.0.1:8333","bucket":"trpc-artifacts"}}
TRPC_SERVICE_STORAGE_PROFILE={"session":"facts","memory":"facts","summary":"facts","knowledge":"vectors","artifact":"objects","audit":"facts"}
