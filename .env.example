# ============================================================
# 环境变量模板
# 用法: 复制为 .env 并填写；已 export 的环境变量优先于 .env
# 注意: .env 已被 .gitignore 排除，严禁提交真实密钥
# ============================================================

# ---------------- 应用 ----------------
# 运行数据目录（SQLite / 日志）
APP_DATA_DIR=data

# ---------------- 模型 ----------------
# DeepSeek API Key（--runner framework 走真实 LLM）
DEEPSEEK_API_KEY=

# ---------------- Admin API ----------------
# 管理接口鉴权密钥（未设置时处于无鉴权状态，启动日志有 WARNING）
TENEURIS_ADMIN_API_KEY=

# ---------------- 企业微信 · 自建应用 ----------------
# HTTP webhook 形态：回调验签、消息加解密、应用消息推送
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_AES_KEY=
# 真发验证的目标成员 userid（verify-wecom-send.py 读取）
WECOM_TO_USER=

# ---------------- 企业微信 · 智能机器人 ----------------
# 长连接形态（--wecom-bot），支持群聊 @；同一 bot 仅单副本
WECOM_BOT_ID=
WECOM_BOT_SECRET=

# ---------------- 飞书 ----------------
# webhook 与 SDK 长连接二选一，同一应用不可双活
# app_id / secret          两种形态共用
# verification_token       webhook 验签用（长连接不需要）
# encrypt_key              webhook 事件加密用（长连接不需要）
# demo_user_open_id        1-on-1 真发验证收件人（个人应用经 OAuth 获取）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_DEMO_USER_OPEN_ID=
