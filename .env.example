# Feishu application credentials. Never commit real values.
TRPC_SERVICE_FEISHU_TENANT_ID=acme
TRPC_SERVICE_FEISHU_APP_ID=
TRPC_SERVICE_FEISHU_APP_SECRET_REF=env://FEISHU_APP_SECRET
TRPC_SERVICE_FEISHU_VERIFICATION_TOKEN_REF=env://FEISHU_VERIFICATION_TOKEN
TRPC_SERVICE_FEISHU_ENCRYPT_KEY_REF=env://FEISHU_ENCRYPT_KEY
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
TRPC_SERVICE_FEISHU_API_BASE_URL=https://open.feishu.cn
TRPC_SERVICE_FEISHU_CONNECTION_MODE=webhook
TRPC_SERVICE_FEISHU_LOG_LEVEL=WARNING
TRPC_SERVICE_LOG_LEVEL=INFO

# Telegram Bot API.
TRPC_SERVICE_TELEGRAM_BOT_TOKEN_REF=env://TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_TOKEN=
TRPC_SERVICE_TELEGRAM_API_BASE_URL=https://api.telegram.org

# WeCom application callback and message API.
TRPC_SERVICE_WECOM_CORP_ID=
TRPC_SERVICE_WECOM_AGENT_ID=
TRPC_SERVICE_WECOM_SECRET_REF=env://WECOM_APP_SECRET
TRPC_SERVICE_WECOM_ENCODING_AES_KEY_REF=env://WECOM_ENCODING_AES_KEY
WECOM_APP_SECRET=
WECOM_ENCODING_AES_KEY=
TRPC_SERVICE_WECOM_API_BASE_URL=https://qyapi.weixin.qq.com
# Intelligent bot WebSocket mode. The Secret is the API-mode bot Secret,
# not the Corp application Secret above.
TRPC_SERVICE_WECOM_BOT_ID=
TRPC_SERVICE_WECOM_BOT_SECRET_REF=env://WECOM_BOT_SECRET
WECOM_BOT_SECRET=
TRPC_SERVICE_WECOM_BOT_TENANT_ID=acme
TRPC_SERVICE_WECOM_BOT_WS_URL=wss://openws.work.weixin.qq.com

# Optional OpenAI-compatible model used by tRPC-Agent-Python.
TRPC_AGENT_MODEL_NAME=
TRPC_AGENT_API_KEY=
TRPC_AGENT_BASE_URL=https://api.openai.com/v1
TRPC_AGENT_FALLBACK_MODEL_NAME=
TRPC_AGENT_FALLBACK_API_KEY=
TRPC_AGENT_FALLBACK_BASE_URL=
TRPC_AGENT_RUN_TIMEOUT_SECONDS=120
TRPC_AGENT_EMBEDDING_MODEL=
TRPC_SERVICE_VECTOR_DIMENSIONS=1536
TRPC_SERVICE_ARTIFACT_BUCKET=
TRPC_SERVICE_ARTIFACT_ENDPOINT_URL=
# JSON map: {"weather":{"callable":"package.module:function","idempotent":true}}
TRPC_AGENT_FUNCTION_TOOLS_JSON={}
# JSON list of streamable_http/SSE MCP endpoints and declared tools.
TRPC_AGENT_MCP_SERVERS_JSON=[]
# Production model sessions should use:
# TRPC_AGENT_SESSION_BACKEND=redis
# TRPC_AGENT_SESSION_REDIS_URL=redis://redis:6379/1

# Service settings.
TRPC_SERVICE_SESSION_HMAC_KEY=development-only-change-me
TRPC_SERVICE_HOST=0.0.0.0
TRPC_SERVICE_PORT=8080
TRPC_SERVICE_WORKER_COUNT=1
TRPC_SERVICE_ROLE=all
TRPC_SERVICE_BACKEND=inmemory
TRPC_SERVICE_DATABASE_URL=postgresql://trpc:trpc@postgres:5432/trpc
TRPC_SERVICE_MIGRATION_DATABASE_URL=postgresql://trpc_owner:replace-me@postgres:5432/trpc
TRPC_SERVICE_CONTROL_DATABASE_URL=postgresql://trpc_control:replace-me@postgres:5432/trpc
TRPC_SERVICE_REDIS_URL=redis://redis:6379/0
TRPC_SERVICE_AUTO_MIGRATE=false
TRPC_SERVICE_QUEUE_RECLAIM_MS=60000
TRPC_SERVICE_QUEUE_STREAM_MAXLEN=100000
TRPC_SERVICE_QUEUE_DLQ_MAXLEN=10000
TRPC_SERVICE_MAX_DELIVERY_ATTEMPTS=3
# InMemory without provider credentials defaults to true; production defaults to false.
TRPC_SERVICE_IM_DRY_RUN=false
TRPC_SERVICE_ADMIN_TOKEN_REF=env://TRPC_ADMIN_TOKEN
TRPC_SERVICE_ADMIN_OPERATOR_TOKEN_REF=env://TRPC_OPERATOR_TOKEN
TRPC_SERVICE_ADMIN_VIEWER_TOKEN_REF=env://TRPC_VIEWER_TOKEN
TRPC_ADMIN_TOKEN=
TRPC_OPERATOR_TOKEN=
TRPC_VIEWER_TOKEN=
OTEL_SERVICE_NAME=trpc-agent-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
