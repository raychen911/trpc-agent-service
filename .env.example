TRPC_SERVICE_ENV=development
TRPC_SERVICE_LOG_LEVEL=INFO
TRPC_SERVICE_DATABASE_URL=sqlite+aiosqlite:///./data/platform.db
TRPC_SERVICE_REDIS_URL=redis://localhost:6379/0
TRPC_SERVICE_SECRET_KEY=change-me-with-at-least-32-random-characters
TRPC_SERVICE_ADMIN_API_KEY=change-this-admin-key
TRPC_SERVICE_SECRET_ENV_ALLOWLIST=[]
TRPC_SERVICE_PUBLIC_BASE_URL=http://localhost:8000
TRPC_SERVICE_OTEL_ENABLED=false
TRPC_SERVICE_OTEL_ENDPOINT=http://localhost:4317
TRPC_SERVICE_MODEL_PROVIDER=mock
TRPC_SERVICE_MODEL_NAME=mock-model
TRPC_SERVICE_MODEL_API_KEY=
TRPC_SERVICE_EVENT_STORE_BACKEND=local
TRPC_SERVICE_EVENT_STORE_PATH=./data/sdk-events
