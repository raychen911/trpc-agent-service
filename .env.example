# Copy to .env and replace every value. Never commit .env.
POSTGRES_DB=trpc_service
POSTGRES_USER=trpc
POSTGRES_PASSWORD=change-me-migration-database-password
MIGRATION_DATABASE_PASSWORD=change-me-migration-role-password
TRPC_RUNTIME_USER=trpc_runtime
RUNTIME_DATABASE_PASSWORD=change-me-runtime-database-password
TRPC_WORKER_USER=trpc_worker
WORKER_DATABASE_PASSWORD=change-me-worker-database-password
METRICS_DATABASE_PASSWORD=change-me-metrics-database-password
REDIS_PASSWORD=change-me-redis-password
MINIO_ROOT_USER=trpc-minio
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_BUCKET=trpc-artifacts
SESSION_HMAC_KEY=change-me-with-at-least-32-random-bytes
EMERGENCY_QUEUE_KEY=change-me-exactly-32-random-byte
DEVELOPMENT_TOKEN=change-me-local-admin-token
TRPC_SERVICE_ENVIRONMENT=development
TRPC_SERVICE_CAPTURE_CONTENT=false
# Keep tenant-controlled file references below this root and keep the
# environment allowlist explicit.  An empty allowlist is fail-closed; add
# exact TRPC_TENANT_* names only when a binding intentionally uses env://.
TRPC_SERVICE_TENANT_SECRET_ROOT=/run/secrets
TRPC_SERVICE_TENANT_SECRET_ENV_NAMES=[]
# Explicit model endpoint host allowlist.  Replace with the hosts approved by
# the deployment; tenant model URLs are rejected when their host is absent.
TRPC_SERVICE_MODEL_ENDPOINT_HOSTS=["api.openai.com"]
# Real model credential mounted only into the Agent Worker. Tenant config
# refers to it as file:///run/secrets/model_api_key and independently selects
# the provider, HTTPS base URL, model ID, timeout, reasoning and sampling.
MODEL_API_KEY=replace-with-model-provider-api-key
# Never use stale Feishu binding metadata in production.
TRPC_SERVICE_FEISHU_ALLOW_STALE_BINDING_CACHE=false
# Keep the official origin for normal runs. A real online-acceptance overlay
# may temporarily use the independent witness path together with
# TRPC_SERVICE_ONLINE_TESTS_ENABLED=true.
TRPC_SERVICE_FEISHU_SEND_API_ROOT=https://open.feishu.cn
TRPC_SERVICE_ONLINE_TESTS_ENABLED=false
# Emergency queue key rotation is versioned.  Previous refs are a JSON map
# such as {"v0":"env://TRPC_SERVICE_EMERGENCY_QUEUE_PREVIOUS_KEY_V0"}; keep
# it empty until the corresponding secret is provisioned.
TRPC_SERVICE_EMERGENCY_QUEUE_KEY_VERSION=v1
TRPC_SERVICE_EMERGENCY_QUEUE_PREVIOUS_KEY_REFS={}
# Select exactly one scheduler version per process.  Keep v2 for new runs;
# use v1 plus its stream/group values only while draining the legacy queue.
TRPC_SERVICE_SCHEDULER_VERSION=v2
TRPC_SERVICE_REDIS_STREAM=trpc:session-ready:v2
TRPC_SERVICE_REDIS_CONSUMER_GROUP=trpc-session-ready-v2
TRPC_SERVICE_RECOVERY_READY_REPLAY_COOLDOWN_SECONDS=30
TRPC_SERVICE_MEDIA_DOWNLOAD_MAX_BYTES=20971520
TRPC_SERVICE_MEDIA_DOWNLOAD_TIMEOUT_SECONDS=30

# Optional live IM acceptance. Use only with deploy/im-online.override.yml.
WECOM_BOT_ID=replace-with-enterprise-wechat-ai-bot-id
WECOM_BOT_SECRET=replace-with-enterprise-wechat-ai-bot-secret
FEISHU_APP_ID=replace-with-feishu-app-id
FEISHU_APP_SECRET=replace-with-feishu-app-secret
FEISHU_VERIFICATION_TOKEN=replace-with-feishu-verification-token
FEISHU_ENCRYPT_KEY=replace-with-feishu-encrypt-key
