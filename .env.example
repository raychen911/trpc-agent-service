TRPC_SERVICE_APP_NAME=trpc-agent-service
TRPC_SERVICE_ENVIRONMENT=development
TRPC_SERVICE_HOST=0.0.0.0
TRPC_SERVICE_PORT=8000
TRPC_SERVICE_LOG_LEVEL=INFO
TRPC_SERVICE_DEBUG=false
TRPC_SERVICE_DATABASE_URL=sqlite+pysqlite:///./data/trpc_service.db
TRPC_SERVICE_AUTO_CREATE_SCHEMA=true
TRPC_SERVICE_CONVERSATION_BACKEND=sql
# production 强制要求 sql；租户发布 session=inmemory 也会被拒绝。
TRPC_SERVICE_COORDINATION_BACKEND=inmemory
# TRPC_SERVICE_REDIS_URL=redis://localhost:6379/0
TRPC_SERVICE_ARTIFACT_BACKEND=local
TRPC_SERVICE_ARTIFACT_ROOT=./data/artifacts
# MinIO 模式需要同时设置 endpoint、access key、secret key：
# TRPC_SERVICE_MINIO_ENDPOINT=127.0.0.1:9000
# TRPC_SERVICE_MINIO_ACCESS_KEY=minioadmin
# TRPC_SERVICE_MINIO_SECRET_KEY=minioadmin
# TRPC_SERVICE_MINIO_BUCKET=trpc-agent-artifacts
# TRPC_SERVICE_MINIO_SECURE=false
TRPC_SERVICE_OUTBOX_WORKER_ENABLED=true
TRPC_SERVICE_OUTBOX_POLL_SECONDS=0.5
TRPC_SERVICE_NODE_ID=local-node-1
TRPC_SERVICE_NODE_BASE_URL=http://127.0.0.1:8000
TRPC_SERVICE_PUBLIC_BASE_URL=http://127.0.0.1:8000
TRPC_SERVICE_NODE_CAPACITY=100
TRPC_SERVICE_NODE_TTL_SECONDS=15
TRPC_SERVICE_NODE_HEARTBEAT_SECONDS=5
TRPC_SERVICE_GATEWAY_INTERNAL_SECRET=development-only-change-me
TRPC_SERVICE_GATEWAY_FORWARD_TIMEOUT_SECONDS=180
TRPC_SERVICE_RUNNER_TIMEOUT_SECONDS=120
TRPC_SERVICE_RUNNER_MAX_LLM_CALLS=20
TRPC_SERVICE_RUNNER_MAX_TOOL_CALLS=20
TRPC_SERVICE_OTEL_ENABLED=false
TRPC_SERVICE_OTEL_SERVICE_NAME=trpc-agent-service
# Compose: http://otel-collector:4318/v1/traces
# TRPC_SERVICE_OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
TRPC_SERVICE_PROMETHEUS_ENABLED=true
TRPC_SERVICE_INBOUND_WORKER_ENABLED=true
TRPC_SERVICE_INBOUND_POLL_SECONDS=0.25
# Admin OIDC/RBAC
TRPC_SERVICE_ADMIN_OIDC_ENABLED=false
# TRPC_SERVICE_ADMIN_OIDC_ISSUER=https://id.example.com/
# TRPC_SERVICE_ADMIN_OIDC_AUDIENCE=trpc-admin
# TRPC_SERVICE_ADMIN_OIDC_JWKS_URL=https://id.example.com/.well-known/jwks.json
TRPC_SERVICE_ADMIN_OIDC_ROLE_CLAIM=roles
TRPC_SERVICE_ADMIN_OIDC_TENANT_CLAIM=tenant_ids
# 内部节点 mTLS 客户端；服务端证书可由独立 internal listener/sidecar 挂载：
# TRPC_SERVICE_INTERNAL_TLS_CA_FILE=/run/tls/ca.crt
# TRPC_SERVICE_INTERNAL_TLS_CERT_FILE=/run/tls/tls.crt
# TRPC_SERVICE_INTERNAL_TLS_KEY_FILE=/run/tls/tls.key
# TRPC_SERVICE_TLS_SERVER_CERT_FILE=/run/tls/server.crt
# TRPC_SERVICE_TLS_SERVER_KEY_FILE=/run/tls/server.key
# TRPC_SERVICE_TLS_CLIENT_CA_FILE=/run/tls/client-ca.crt
# Vault/KMS secret references: vault://secret/data/path#field, aws-kms://BASE64_CIPHERTEXT
# TRPC_SERVICE_VAULT_ADDRESS=https://vault.example.com
# TRPC_SERVICE_VAULT_TOKEN=use-workload-identity-in-production
# TRPC_SERVICE_VAULT_NAMESPACE=team
# TRPC_SERVICE_AWS_REGION=ap-southeast-1
TRPC_SERVICE_VECTOR_BACKEND=inmemory
# TRPC_SERVICE_QDRANT_URL=http://127.0.0.1:6333
# TRPC_SERVICE_QDRANT_API_KEY=
TRPC_SERVICE_QDRANT_COLLECTION=trpc_agent_vectors
TRPC_SERVICE_RELEASE_TRACK=stable
# TRPC_SERVICE_CANARY_TENANT_IDS=tenant-a,tenant-b

# 企业微信智能机器人 API（URL 回调模式）。真实值仅放本机 .env。
# WECOM_AIBOT_CALLBACK_TOKEN=管理后台API配置中的Token
# WECOM_AIBOT_ENCODING_AES_KEY=管理后台API配置中的43字符EncodingAESKey
