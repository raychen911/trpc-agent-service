# test | development | production
TRPC_SERVICE_APP_ENV=development
TRPC_SERVICE_HOST=127.0.0.1
TRPC_SERVICE_PORT=8000
TRPC_SERVICE_LOG_LEVEL=INFO
TRPC_SERVICE_DATABASE_URL=sqlite+aiosqlite:///./data/trpc_agent_service.db
TRPC_SERVICE_ARTIFACT_ROOT=./data/artifacts
TRPC_SERVICE_AGENT_TIMEOUT_SECONDS=120
TRPC_SERVICE_OTEL_CONSOLE_EXPORTER=false

# Multi-replica mode. Leave inline for the normal single-process startup.
TRPC_SERVICE_EXECUTION_BACKEND=inline
TRPC_SERVICE_QUEUE_REDIS_URL_REF=env://TRPC_QUEUE_REDIS_URL
TRPC_SERVICE_QUEUE_STREAM=trpc-service:agent-runs
TRPC_SERVICE_QUEUE_CONSUMER_GROUP=trpc-service-workers
TRPC_QUEUE_REDIS_URL=redis://127.0.0.1:6379/0

# Normal development and final demonstrations must use a real provider.
TRPC_SERVICE_MODEL_PROVIDER=openai
TRPC_SERVICE_MODEL_NAME=zai-org/GLM-5.2
TRPC_SERVICE_MODEL_BASE_URL=https://api.siliconflow.cn/v1
TRPC_SERVICE_MODEL_API_KEY_REF=env://TRPC_AGENT_API_KEY

# References stay in configuration; local values are filled below in the ignored .env file.
# Production deployments may inject the same names through a Secret manager.
TRPC_SERVICE_ADMIN_API_KEY_REF=env://TRPC_SERVICE_ADMIN_API_KEY
TRPC_SERVICE_SESSION_HMAC_KEY_REF=env://TRPC_SERVICE_SESSION_HMAC_KEY

# Fill these values in the ignored local .env file. Never commit that file.
TRPC_AGENT_API_KEY=
TRPC_SERVICE_ADMIN_API_KEY=
TRPC_SERVICE_SESSION_HMAC_KEY=
TRPC_DEMO_TENANT_API_KEY=
TRPC_TELEGRAM_BOT_TOKEN=
TRPC_WECOM_BOT_SECRET=

# Optional tenant Redis backend. Tenant records reference this value as env://TRPC_REDIS_URL.
TRPC_REDIS_URL=redis://127.0.0.1:6379/0
