# The memory backend and mock model make the demonstration work without services or credentials.
TRPC_SERVICE_RUNTIME_BACKEND=memory
TRPC_SERVICE_ENVIRONMENT=development
TRPC_SERVICE_HOST=0.0.0.0
TRPC_SERVICE_PORT=8000
TRPC_SERVICE_LOG_LEVEL=INFO
TRPC_SERVICE_DATABASE_URL=postgresql+asyncpg://trpc:trpc@postgres:5432/trpc_agent
# Development only. Production Compose uses isolated credentials in
# .api.env/.worker.env/.dispatcher.env/.migrator.env instead.
TRPC_SERVICE_DATABASE_ROLE=
TRPC_SERVICE_REDIS_URL=redis://redis:6379/0
TRPC_SERVICE_OBJECT_STORE_ENDPOINT=http://minio:9000
TRPC_SERVICE_OBJECT_STORE_BUCKET=trpc-artifacts
TRPC_SERVICE_OBJECT_STORE_ACCESS_KEY=minioadmin
TRPC_SERVICE_OBJECT_STORE_SECRET_KEY=minioadmin
TRPC_SERVICE_OTEL_ENDPOINT=http://otel-collector:4317
TRPC_SERVICE_ADMIN_API_KEY=change-me-before-production
# JSON map of tenant IDs to direct-run API keys. Admin credentials always span
# all tenants; a tenant key can access only its path tenant.
TRPC_SERVICE_TENANT_API_KEYS={}
TRPC_SERVICE_EXECUTION_LEASE_SECONDS=60
TRPC_SERVICE_EXECUTION_HEARTBEAT_SECONDS=15
TRPC_SERVICE_MODEL_MAX_OUTPUT_TOKENS=1024
TRPC_SERVICE_MODEL_INPUT_OVERHEAD_TOKENS=256

# Leave these empty to use the deterministic model.  Set all three for a real,
# OpenAI-compatible endpoint; no key is stored in the database.
TRPC_AGENT_API_KEY=
TRPC_AGENT_BASE_URL=
TRPC_AGENT_MODEL_NAME=mock-deterministic
