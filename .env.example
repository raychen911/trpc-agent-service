TRPC_MODEL_PROVIDER=openai-compatible
TRPC_MODEL_NAME=deepseek-chat
TRPC_MODEL_BASE_URL=https://api.deepseek.com/v1
TRPC_MODEL_API_KEY_ENV=TRPC_MODEL_API_KEY
TRPC_MODEL_API_KEY=

# Gateway
TRPC_GATEWAY_HOST=127.0.0.1
TRPC_GATEWAY_PORT=8000

# Worker A (development: started by start.sh)
TRPC_WORKER_A_HOST=127.0.0.1
TRPC_WORKER_A_PORT=8001
TRPC_WORKER_A_PID_FILE=data/worker-a.pid
TRPC_WORKER_A_LOG_FILE=data/worker-a.log

# Worker B (development: started by start.sh)
TRPC_WORKER_B_HOST=127.0.0.1
TRPC_WORKER_B_PORT=8002
TRPC_WORKER_B_PID_FILE=data/worker-b.pid
TRPC_WORKER_B_LOG_FILE=data/worker-b.log

# Worker pool (Stage 3C: composed by start.sh from A/B, or set manually)
TRPC_WORKER_BASE_URLS=http://127.0.0.1:8001,http://127.0.0.1:8002
TRPC_WORKER_HEALTH_INTERVAL_SECONDS=2
TRPC_WORKER_HEALTH_TIMEOUT_SECONDS=1
TRPC_WORKER_HEALTH_FAILURE_THRESHOLD=2
TRPC_WORKER_HEALTH_RECOVERY_THRESHOLD=2

# Internal authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
TRPC_INTERNAL_TOKEN=

# Admin API (standalone process; token must be >= 32 chars, do NOT reuse TRPC_INTERNAL_TOKEN)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
TRPC_ADMIN_TOKEN=

# Redis (required for Worker)
TRPC_REDIS_URL=redis://localhost:6379
TRPC_REDIS_SESSION_TTL_SECONDS=604800
TRPC_REDIS_MEMORY_TTL_SECONDS=2592000

# PostgreSQL (required for Gateway and Worker since Stage 4A)
# Scheme must be postgresql+asyncpg
TRPC_DATABASE_URL=postgresql+asyncpg://trpc:trpc@localhost:5432/trpc
TRPC_DATABASE_POOL_SIZE=5
TRPC_DATABASE_MAX_OVERFLOW=10
TRPC_DATABASE_POOL_TIMEOUT=30
TRPC_DATABASE_CONNECT_TIMEOUT=10

# S3/MinIO Artifact backend (R1C). start.sh generates ephemeral local values
# when the endpoint is empty; Compose requires explicit non-empty values.
TRPC_S3_ENDPOINT=
TRPC_S3_ACCESS_KEY=
TRPC_S3_SECRET_KEY=
TRPC_S3_BUCKET=trpc-artifacts

# Container ownership marker files (start.sh/stop.sh)
# start.sh writes the container name to these files; stop.sh only stops containers
# whose name matches the marker. Prevents accidentally stopping dev containers.
TRPC_REDIS_MARKER_FILE=
TRPC_POSTGRES_MARKER_FILE=

# Session execution lock (Stage 3C)
TRPC_SESSION_LOCK_WAIT_SECONDS=5
TRPC_SESSION_LOCK_LEASE_SECONDS=30
TRPC_SESSION_LOCK_RENEW_SECONDS=10

# WeCom AI Bot (account ID and tenant authority come from an enabled ChannelBinding)
## Set the environment variable referenced by that binding's secret_ref.
TRPC_WECOM_BOT_SECRET=
# WeCom standard HTTP callback (optional; both are required for a webhook binding)
TRPC_WECOM_WEBHOOK_TOKEN=
TRPC_WECOM_WEBHOOK_AES_KEY=

# Feishu AI Bot (App ID and tenant authority come from an enabled ChannelBinding)
TRPC_FEISHU_APP_SECRET=

# OpenTelemetry tracing (Stage 6B1 — disabled by default; leaving the
# endpoint empty keeps tracing off and makes no network connection)
TRPC_TRACE_ENABLED=false
# OTLP HTTP collector endpoint, http/https only; no credentials, query or
# fragment. Required when TRPC_TRACE_ENABLED=true.
TRPC_TRACE_OTLP_ENDPOINT=
# Head sampling ratio for local-root traces, 0 <= value <= 1 (children of a
# propagated trace always follow the parent decision).
TRPC_TRACE_SAMPLE_RATIO=1.0
# Bounded exporter/flush/shutdown timeout in seconds (must be > 0).
TRPC_TRACE_EXPORT_TIMEOUT_SECONDS=5.0

# Docker Compose (Stage 7A — compose.yaml interpolates ONLY these plus the
# TRPC_MODEL_* / TRPC_INTERNAL_TOKEN / TRPC_ADMIN_TOKEN values above from the
# host environment).  Compose never enables IM long connections from this
# file: create the optional deploy/im.env to opt in.
TRPC_COMPOSE_PG_USER=trpc
TRPC_COMPOSE_PG_PASSWORD=
TRPC_COMPOSE_PG_DB=trpc
# TRPC_TRACE_ENABLED=false keeps the collector idle; the service still runs.
