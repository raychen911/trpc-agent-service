# 复制为 .env 并填入真实值（.env 不进仓库）

# ---- 模型 ----
KEY=sk-your-model-api-key
URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL=qwen3.7-flash

# ---- 平台数据库（tenant / audit_log / channel_binding / idempotency）----
SQL_URL=mysql+pymysql://user:password@127.0.0.1:3306/trpc_agent

# ---- 安全（未配置 = 开发模式放行）----
ADMIN_API_KEY=
CHAT_API_KEY=
CORS_ORIGINS=http://localhost:8000

# ---- IM 通道凭证（tenants.yaml 留空占位，凭证只走环境变量）----
# WECOM_TOKEN=企微HTTP回调Token
# WECOM_AES_KEY=企微HTTP回调43位EncodingAESKey
# WECOM_BOT_SECRET=企微智能机器人BotSecret（长连接通道）
# FEISHU_APP_SECRET=飞书AppSecret
# FEISHU_TOKEN=飞书VerificationToken
# FEISHU_ENCRYPT_KEY=飞书EncryptKey

# ---- 多节点共享状态（可选）----
# BUDGET_REDIS_URL=redis://localhost:6379/1
# DEDUPE_REDIS_URL=redis://localhost:6379/2
# QUEUE_MODE=redis
# REDIS_URL=redis://localhost:6379/3

# ---- 可观测（可选）----
# OTEL_ENABLED=1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
