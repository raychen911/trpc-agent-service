// Tail the rotating host-Python JSON files and send them to local Loki.
local.file_match "trpc_service_logs" {
  path_targets = [{
    "__path__"     = "/var/log/trpc/*.log*",
    "service_name" = "trpc-agent-service",
  }]
}

loki.source.file "trpc_service_logs" {
  targets    = local.file_match.trpc_service_logs.targets
  forward_to = [loki.process.trpc_service_logs.receiver]
}

loki.process "trpc_service_logs" {
  stage.json {
    expressions = {
      environment = "environment",
      level       = "level",
      logger      = "logger",
      node_id     = "node_id",
      node_role   = "node_role",
    }
  }

  // Keep labels operational and bounded. Tenant/request identifiers stay in
  // the JSON body and remain queryable without causing label-cardinality blowup.
  stage.labels {
    values = {
      environment = "",
      level       = "",
      node_role   = "",
    }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

