TRPC_SERVICE_ENVIRONMENT=production
TRPC_SERVICE_RUNTIME_BACKEND=postgres
TRPC_SERVICE_DATABASE_URL=postgresql+asyncpg://trpc_worker:replace-with-url-encoded-worker-password@postgres:5432/trpc_agent
TRPC_SERVICE_DATABASE_ROLE=agent_worker
TRPC_SERVICE_REDIS_URL=redis://redis:6379/0
TRPC_SERVICE_STORAGE_PROFILE_ROOT=/var/lib/trpc-storage
