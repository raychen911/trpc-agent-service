# Kept only on the Compose host (mode 0600).  Use randomly generated values.
# For a newly initialized volume, POSTGRES_PASSWORD is the recovery/bootstrap
# credential.  On an existing legacy volume, set TRPC_DB_BOOTSTRAP_USER and
# TRPC_DB_BOOTSTRAP_PASSWORD to its current privileged login for the one-time
# role provisioning command.
POSTGRES_PASSWORD=replace-with-a-long-random-bootstrap-password
TRPC_DB_BOOTSTRAP_USER=postgres
TRPC_DB_BOOTSTRAP_PASSWORD=replace-with-the-bootstrap-password
TRPC_DB_API_PASSWORD=replace-with-a-long-random-api-password
TRPC_DB_WORKER_PASSWORD=replace-with-a-long-random-worker-password
TRPC_DB_DISPATCHER_PASSWORD=replace-with-a-long-random-dispatcher-password
TRPC_DB_MIGRATOR_PASSWORD=replace-with-a-long-random-migrator-password
TRPC_DB_AIBOT_PASSWORD=replace-with-a-long-random-aibot-password
