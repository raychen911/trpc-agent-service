TRPC_SERVICE_ENVIRONMENT=production
TRPC_SERVICE_RUNTIME_BACKEND=postgres
TRPC_SERVICE_DATABASE_URL=postgresql+asyncpg://trpc_api_gateway:replace-with-url-encoded-api-password@postgres:5432/trpc_agent
TRPC_SERVICE_DATABASE_ROLE=agent_api_gateway
TRPC_SERVICE_REDIS_URL=redis://redis:6379/0
TRPC_SERVICE_OBJECT_STORE_ENDPOINT=http://minio:9000
TRPC_SERVICE_OTEL_ENDPOINT=otel-collector:4317
TRPC_SERVICE_ADMIN_API_KEY=replace-with-a-long-random-admin-api-key
# Optional direct-run keys: JSON object mapping exact tenant id to a key.
TRPC_SERVICE_TENANT_API_KEYS={}
