# ===================================================================
# .dockerignore - Docker 构建上下文排除清单
# ===================================================================
# 说明: 减小构建上下文体积、避免把本地缓存/密钥带入构建环境。
#   当前 Dockerfile 只 COPY requirements.txt（依赖安装），
#   其余源码/测试/脚本由 CNB 启动时 git 拉取，无需进构建上下文。
# 规范: 密钥（.env）绝不进上下文；VCS/缓存/日志/子模块一律排除。
# ===================================================================

# ---- 密钥（绝不进入构建上下文）----
.env
.env.*
!.env.example

# ---- 版本控制 ----
.git
.gitmodules
.gitignore


# ---- Python 缓存与构建产物 ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- 运行时数据与日志（不进入镜像，容器内挂载）----
data/
*.log
*.db
*.sqlite3

# ---- 本地工具目录 ----
.agent/
.venv/
venv/
node_modules/
