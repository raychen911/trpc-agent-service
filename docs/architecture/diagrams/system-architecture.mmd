  STORAGE_PROFILE -.->|"后端路由"| JOB_STORAGE_ADAPTER
  POLICY_BUNDLE -.->|"本地策略"| OPA

  ADMIN_API -.->|"控制面元数据 / Audit Outbox"| POSTGRES
