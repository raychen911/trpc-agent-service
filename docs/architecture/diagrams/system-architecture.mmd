%%{init: {"theme":"base","themeVariables":{"fontFamily":"Arial, Microsoft YaHei, sans-serif","primaryTextColor":"#172033","lineColor":"#52606d"},"flowchart":{"curve":"basis","htmlLabels":true}}}%%
flowchart TB
  subgraph EXTERNAL["企业外部系统"]
    direction LR
    PLATFORM_USER["平台用户"]
    API_CLIENT["HTTP / SSE / AG-UI / A2A 客户端"]
    IM_USER["IM 用户"]
    OIDC["企业 OIDC"]
    WECOM["企业微信"]
    FEISHU["飞书"]
    MODEL_PROVIDER["模型供应商 / 私有模型 Endpoint"]
    EXTERNAL_TOOL["外部 Tool / MCP Server"]
  end

  subgraph PRODUCTION["Production 环境｜企业私有化部署"]
    direction TB

    subgraph TENANT_SCOPE["租户逻辑隔离范围｜tenant_id 必须贯穿身份、配置、消息、存储、预算与审计"]
      direction LR
      CHANNEL_BINDING["通道绑定"]
      RELEASE_DEPLOYMENT["Agent Release / Deployment"]
      STORAGE_PROFILE["存储配置档"]
      POLICY_BUNDLE["治理策略 / Policy Bundle"]
    end

    subgraph CONTROL_PLANE["控制面"]
      direction LR
      WEB_CONSOLE["Web Console<br/>部署单元"]
      ADMIN_API["Admin API<br/>部署单元"]
    end

    subgraph DATA_PLANE["数据面"]
      direction LR
      AGENT_GATEWAY["Agent Gateway<br/>部署单元"]

      subgraph CHANNEL_GATEWAY["Channel Gateway｜部署单元"]
        direction TB
        WECOM_ADAPTER["企业微信 Channel Adapter<br/>进程内插件"]
        FEISHU_ADAPTER["飞书 Channel Adapter<br/>进程内插件"]
        CHANNEL_CORE["验签 / 解密 / 绑定解析<br/>入站幂等 / 回复投递"]
        WECOM_ADAPTER --> CHANNEL_CORE
        FEISHU_ADAPTER --> CHANNEL_CORE
      end

      subgraph AGENT_WORKER["Agent Worker｜部署单元"]
        direction TB
        AGENT_CORE["执行状态机 / Session 并发控制"]
        RUNNER["tRPC-Agent Runner"]
        FILTER["Filter<br/>Runner 管线内模块"]
        AGENT_STORAGE_ADAPTER["Storage Adapter<br/>进程内模块"]
        AGENT_CORE --> RUNNER
        RUNNER --> FILTER
        AGENT_CORE --> AGENT_STORAGE_ADAPTER
      end

      subgraph JOB_WORKER["Job Worker｜部署单元"]
        direction TB
        JOB_CORE["Summary / Memory / Knowledge<br/>迁移 / 删除 / 审计 / 补偿"]
        JOB_STORAGE_ADAPTER["Storage Adapter<br/>进程内模块"]
        JOB_CORE --> JOB_STORAGE_ADAPTER
      end

      OUTBOX_PUBLISHER["Outbox Publisher<br/>逻辑组件；部署归属未冻结"]
    end

    subgraph INFRA["治理与基础设施"]
      direction LR
      KAFKA[("Kafka 兼容执行总线")]
      POSTGRES[("PostgreSQL<br/>权威状态 / 幂等 / Outbox / 审计索引")]
      REDIS[("Redis<br/>缓存 / 限流 / fencing 租约")]
      VECTOR[("PostgreSQL / PGVector<br/>Knowledge / 语义 Memory")]
      OBJECT_STORE[("S3 兼容对象存储<br/>Artifact / 知识源 / 归档")]
      OPA["OPA Sidecar<br/>Policy Bundle"]
      VAULT["OpenBao / Vault<br/>密钥引用解析"]
      LLM_GATEWAY["LLM Gateway<br/>基础设施部署"]
      OTEL["OpenTelemetry Collector"]
      OBSERVABILITY["Prometheus / Tempo / Loki / Grafana"]
      PLATFORM_RUNTIME["Kubernetes / Istio Ambient Mesh<br/>Helm / Argo"]
    end
  end

  PLATFORM_USER -->|"浏览器"| WEB_CONSOLE
  WEB_CONSOLE -->|"同步 REST / OpenAPI"| ADMIN_API
  ADMIN_API -->|"OIDC 认证"| OIDC
  API_CLIENT -->|"同步协议 / 流式连接"| AGENT_GATEWAY
  IM_USER --> WECOM
  IM_USER --> FEISHU
  WECOM -->|"HTTPS 回调"| WECOM_ADAPTER
  FEISHU -->|"Webhook / 长连接"| FEISHU_ADAPTER

  ADMIN_API -->|"管理"| CHANNEL_BINDING
  ADMIN_API -->|"发布"| RELEASE_DEPLOYMENT
