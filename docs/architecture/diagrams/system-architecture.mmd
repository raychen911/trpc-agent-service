  AGENT_STORAGE_ADAPTER -.->|"缓存"| REDIS
  AGENT_STORAGE_ADAPTER -.->|"Knowledge / Memory"| VECTOR
  AGENT_STORAGE_ADAPTER -.->|"Artifact"| OBJECT_STORE
  JOB_STORAGE_ADAPTER -.->|"Summary / 审计索引 / Outbox"| POSTGRES
  JOB_STORAGE_ADAPTER -.->|"缓存失效"| REDIS
  JOB_STORAGE_ADAPTER -.->|"Memory / Knowledge"| VECTOR
  JOB_STORAGE_ADAPTER -.->|"Artifact / 归档"| OBJECT_STORE

  FILTER -->|"同步策略决策"| OPA
  AGENT_GATEWAY -->|"同步策略决策"| OPA
  CHANNEL_CORE -->|"同步策略决策"| OPA
  JOB_CORE -->|"同步策略决策"| OPA
  RUNNER -->|"同步模型调用"| LLM_GATEWAY
  RUNNER -->|"受治理的 Tool 调用"| EXTERNAL_TOOL
  LLM_GATEWAY -.->|"密钥引用"| VAULT
  LLM_GATEWAY -->|"受控出口"| MODEL_PROVIDER
  ADMIN_API -.->|"密钥引用"| VAULT
  WECOM_ADAPTER -.->|"密钥引用"| VAULT
  FEISHU_ADAPTER -.->|"密钥引用"| VAULT

  ADMIN_API -.->|"遥测"| OTEL
  AGENT_GATEWAY -.->|"遥测"| OTEL
  CHANNEL_CORE -.->|"遥测"| OTEL
  AGENT_CORE -.->|"遥测"| OTEL
  JOB_CORE -.->|"遥测 / Span Link"| OTEL
  LLM_GATEWAY -.->|"遥测"| OTEL
  OTEL -.->|"指标 / Trace / 日志"| OBSERVABILITY
  PLATFORM_RUNTIME -.->|"调度 / mTLS / GitOps"| ADMIN_API
  PLATFORM_RUNTIME -.->|"调度 / mTLS / GitOps"| AGENT_GATEWAY
  PLATFORM_RUNTIME -.->|"调度 / mTLS / GitOps"| CHANNEL_CORE
  PLATFORM_RUNTIME -.->|"调度 / mTLS / GitOps"| AGENT_CORE
  PLATFORM_RUNTIME -.->|"调度 / mTLS / GitOps"| JOB_CORE

  subgraph LEGEND["连线语义"]
