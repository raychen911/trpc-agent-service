# archives must never enter repository history.
/runs/**
!/runs/multitenant/
!/runs/multitenant/run-final-fault-gate.ps1
!/runs/multitenant/run-final-runtime-gates.ps1
!/runs/multitenant/run-final-ack-performance.ps1
