# Copy to .env.local and source it before starting the backend.
# Secrets are read only by server.py and are never sent to the browser.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
NEXT_PUBLIC_AGENT_API_URL=http://127.0.0.1:8765
REDIS_URL=redis://127.0.0.1:16379/0
MYSQL_URL=mysql+aiomysql://agent_test:agent_test_only@127.0.0.1:13306/agent_test
# Production must use a long random value from a secret manager. MyTestWeb has
# a local-only fallback so this can be left blank for disposable validation.
TENANT_CONFIG_ENCRYPTION_KEY=
